[Unit]
Description=likeadmin-SaaS Go API
After=network.target mysql.service redis.service mariadb.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/likeadmin/backend
Environment=LIKEADMIN_CONFIG=/opt/likeadmin/backend/configs/config.yaml
Environment=LIKEADMIN_LISTEN=:8080
# Keep PHP fallback off once pair.sh is green on this host.
Environment=LIKEADMIN_PHP_FALLBACK=0
# Production (debug=false) rejects unauthenticated GET /crontab. Prefer cmd/crontab.
# Set a token only if wget-style HTTP triggers are still required:
# Environment=LIKEADMIN_CRONTAB_TOKEN=change-me
ExecStart=/opt/likeadmin/backend/bin/api
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
