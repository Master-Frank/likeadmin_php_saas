[Unit]
Description=likeadmin-SaaS Go crontab worker
After=network.target mysql.service redis.service likeadmin-api.service
Wants=mysql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/likeadmin/backend
Environment=LIKEADMIN_CONFIG=/opt/likeadmin/backend/configs/config.yaml
Environment=LIKEADMIN_DEBUG=false
# This worker is the production scheduler. Do not rely on HTTP GET /crontab.
ExecStart=/opt/likeadmin/backend/bin/crontab
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
